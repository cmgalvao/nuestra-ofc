---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import { whatsappUrl } from '../lib/contact';

const crumbs = [{ name: 'Sobre', path: '/sobre/' }];
const valores = [
  { nome: 'Planejamento e antecipação', texto: 'a gente olha o horizonte antes de decolar.' },
  { nome: 'Criatividade propositiva', texto: 'ideias que resolvem o problema e abrem caminho.' },
  { nome: 'Organização', texto: 'processo claro, prazos cumpridos, sem turbulência.' },
  { nome: 'Referência', texto: 'repertório e boas práticas para elevar cada entrega.' },
];
---
<BaseLayout
  title="Sobre"
  description="Comunicação é como um voo: precisa de direção, estratégia e visão. Conheça a tripulação da Nuestra, agência de comunicação e marketing em Santa Maria/RS."
  path="/sobre/"
  breadcrumbs={crumbs}
  showBreadcrumbs={false}
>
  <PageHead
    title="Do alto, vemos além."
    intro="Comunicação é como um voo: precisa de direção, estratégia e visão. Por isso, na Nuestra, a gente sobe para enxergar o todo antes de decidir o próximo passo."
    crumbs={crumbs}
  />
  <section class="corpo">
    <div class="wrap">
      <article class="card">
        <p>
          Somos uma tripulação experiente em atendimento, planejamento, redação, direção de arte, audiovisual e gestão
          de tráfego. Cada projeto é conduzido por um time que pensa junto, para que a sua marca chegue mais longe, com
          mais clareza e mais resultado.
        </p>
        <p>
          À frente da tripulação, Marília Zabott. Engenheira agrônoma e relações-públicas, mestre em Agronegócios e com
          15 anos de experiência em comunicação e marketing.
        </p>
        <h2>O que nos move</h2>
        <ul>
          {valores.map((v) => <li><strong>{v.nome}:</strong> {v.texto}</li>)}
        </ul>
        <p class="fecho">Porque aqui, o seu negócio vai mais longe.</p>
        <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener">Falar com a Nuestra</a>
      </article>
    </div>
  </section>
</BaseLayout>
<style>
  .corpo { background: url('../assets/papel.webp') center / 30rem #f3efe8; padding: 2rem 1rem 3rem; color: var(--navy); }
  .wrap { max-width: 48rem; margin: 0 auto; }
  .card { background: #fff; border-radius: 0.75rem; box-shadow: 0 6px 18px rgba(1, 62, 80, 0.12); padding: 1.5rem 1.25rem 1.75rem; }
  p { margin: 0 0 1rem; line-height: 1.6; color: #1d4452; }
  h2 { margin: 1.5rem 0 0.5rem; font-weight: 800; font-size: clamp(1.4rem, 6vw, 1.9rem); line-height: 1.15; }
  ul { margin: 0 0 1.25rem; padding: 0; list-style: none; }
  li { padding: 0.55rem 0; border-top: 1px dashed rgba(1, 62, 80, 0.25); line-height: 1.5; }
  li::before { content: '✓ '; color: var(--orange); font-weight: 700; }
  .fecho { font-family: var(--font-title); font-style: italic; font-weight: 700; font-size: 1.2rem; line-height: 1.3; color: var(--orange); }
  .btn { display: inline-block; background: var(--orange-light); color: var(--navy); font-weight: 500; padding: 0.75rem 1.4rem; border-radius: 999px; text-decoration: none; }
  .btn:focus-visible { outline: 3px solid var(--navy); outline-offset: 3px; }
  @media (min-width: 900px) { .card { padding: 2rem 2rem 2.25rem; } .corpo { padding: 3rem 1rem 4rem; } }
</style>
