---
import { withBase } from '../../lib/url';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../config/site';
import { canonicalUrl } from '../../lib/seo';
import { whatsappUrl } from '../../lib/contact';
import { optionalCollection } from '../../lib/optional-collection';
import { dataBR, dataISO } from '../../lib/format';
import balao from '../../assets/balao.png';
import papel from '../../assets/papel.webp';
import logo from '../../assets/logo-horizontal.png';

export async function getStaticPaths() {
  const posts = await optionalCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { titulo, descricao, capa, capaAlt, data, autor, chamada = 'Vamos decolar juntos?' } = entry.data;
const { Content } = await render(entry);
const path = `/blog/${entry.id}/`;
const url = canonicalUrl(path);
const crumbs = [{ name: 'Blog', path: '/blog/' }, { name: titulo, path }];
const minutos = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).filter(Boolean).length / 200));
const imagemOg = await getImage({ src: capa, width: 1200 });
// Arte de story: o navegador desenha com estas imagens quando a pessoa toca em "Instagram".
const capaStory = await getImage({ src: capa, width: 1080, format: 'jpg' });
const logoStory = await getImage({ src: logo, width: 600, format: 'webp' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: dataISO(data),
  author: { '@type': 'Person', name: autor },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  image: new URL(imagemOg.src, SITE.url).href,
  mainEntityOfPage: url,
};
---
<BaseLayout title={titulo} description={descricao} path={path} breadcrumbs={crumbs} showBreadcrumbs={false}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="post">
    <header class="topo" style={`--papel: url(${papel.src})`}>
      <div class="grain" aria-hidden="true"></div>
      <div class="arch" aria-hidden="true"></div>
      <Image class="bal" src={balao} alt="" widths={[160, 320]} sizes="(min-width: 900px) 160px, 88px" loading="eager" />
      <div class="inner">
        <div class="trail"><Breadcrumbs items={crumbs} /></div>
        <p class="eyebrow">Visão de cima</p>
        <h1><span>{titulo}</span></h1>
        <p class="meta">
          <time datetime={dataISO(data)}>{dataBR(data)}</time>
          <span aria-hidden="true">·</span> <span>{autor}</span>
          <span aria-hidden="true">·</span> <span>{minutos} min de leitura</span>
        </p>
      </div>
    </header>

    <div class="capa">
      <Image src={capa} alt={capaAlt} widths={[640, 960, 1440]} sizes="(min-width: 900px) 56rem, 100vw" loading="eager" />
    </div>

    <div class="papel">
      <div class="coluna">
        <div class="corpo"><Content /></div>

        <aside class="cta" aria-label="Fale com a Nuestra">
          <p class="cta-t">{chamada}</p>
          <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Falar com a Nuestra</a>
        </aside>

        <div class="compartilhar">
          <span>Compartilhar:</span>
          <a href={`https://wa.me/?text=${encodeURIComponent(`${titulo} ${url}`)}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <button type="button" data-abrir-story>Instagram</button>
          <button type="button" data-copiar={url}>Copiar link</button>
        </div>
        <dialog
          class="story"
          data-story
          data-link={url}
          data-titulo={titulo}
          data-capa={capaStory.src}
          data-logo={logoStory.src}
          data-papel={papel.src}
          data-arquivo={`nuestra-${entry.id}.jpg`}
          aria-labelledby="story-t"
        >
          <button type="button" class="fechar" data-fechar aria-label="Fechar">×</button>
          <p class="story-t" id="story-t">Leve este voo para o seu story</p>
          <canvas width="1080" height="1920" role="img" aria-label={`Arte do story: ${titulo}`}></canvas>
          <ol>
            <li>O link do texto é copiado junto.</li>
            <li>No Instagram, escolha <b>Stories</b>.</li>
            <li>Adicione a figurinha <b>Link</b> e cole.</li>
          </ol>
          <button type="button" class="btn enviar" data-enviar disabled>Preparando a arte…</button>
          <p class="aviso" data-aviso role="status"></p>
        </dialog>
        <a class="volta" href={withBase('/blog/')}><span aria-hidden="true">←</span> Todos os posts</a>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/post';
</script>

<style>
  .post { color: var(--navy); }

  /* Abertura: mesma linguagem do PageHead (verde, grão, arco laranja e balão) */
  .topo { position: relative; overflow: hidden; background: var(--teal); color: #fff; }
  .grain { position: absolute; inset: 0; background-image: var(--grain); opacity: var(--grain-opacity); pointer-events: none; }
  .arch { position: absolute; right: -2rem; bottom: 0; width: 10rem; height: 13.75rem; background: var(--orange); border-radius: 5rem 5rem 0 0; }
  .topo :global(.bal) { position: absolute; right: 0.8rem; bottom: 3rem; width: 5.5rem; height: auto; animation: floaty 7s ease-in-out infinite; }
  .inner { position: relative; max-width: 56rem; margin: 0 auto; padding: 0.5rem 1.25rem 4.5rem; }
  .trail :global(.breadcrumbs) { padding: 0.75rem 0; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .trail :global(ol) { margin: 0; }
  /* O título já está logo abaixo: o caminho mostra só Home › Blog. */
  .trail :global(li:last-child) { display: none; }
  .eyebrow { margin: 0.75rem 0 0.6rem; font-size: 0.75rem; font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: var(--orange-light); }
  h1 {
    margin: 0 0 0 -0.4rem; max-width: 40rem; padding-right: 5rem; transform: rotate(-1.2deg);
    font-weight: 800; font-size: clamp(1.7rem, 1.1rem + 3vw, 3rem); line-height: 1.12; color: var(--navy); overflow-wrap: anywhere;
  }
  h1 span {
    display: inline; padding: 0.15rem 0.6rem; line-height: 1.55; -webkit-box-decoration-break: clone; box-decoration-break: clone;
    background: var(--papel) center / cover var(--cream); box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }
  .meta { margin: 1.4rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.875rem; letter-spacing: 0.04em; color: #fff; }

  .capa { position: relative; z-index: 2; max-width: 56rem; margin: -2.75rem auto 0; padding: 0 1rem; }
  .capa :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.75rem; box-shadow: 0 14px 30px rgba(1, 62, 80, 0.28); }

  /* Texto */
  .papel { background: url('../../assets/papel.webp') center / 30rem var(--cream); margin-top: -6rem; padding: 8.5rem 1rem 4rem; }
  .coluna { max-width: 44rem; margin: 0 auto; }
  .corpo { font-size: 1.125rem; }
  .corpo :global(p) { margin: 0 0 1.35rem; line-height: 1.75; color: #1d4452; }
  .corpo :global(p:first-child::first-letter) {
    float: left; font-family: var(--font-title); font-weight: 800; font-size: 4.2rem; line-height: 0.85;
    margin: 0.35rem 0.6rem 0 0; color: var(--orange);
  }
  /* Parágrafo inteiro em itálico no markdown (*assim*) vira frase de virada. */
  .corpo :global(p:has(> em:only-child)) {
    margin: 2.25rem 0; font-family: var(--font-title); font-style: italic; font-weight: 700;
    font-size: clamp(1.35rem, 1.1rem + 1vw, 1.7rem); line-height: 1.3; color: var(--teal);
  }
  .corpo :global(h2) { margin: 2.25rem 0 0.75rem; font-weight: 800; font-size: 1.5rem; line-height: 1.2; }

  .cta { margin: 3rem 0 2rem; padding: 2rem 1.5rem; border-radius: 1rem; background: var(--navy); color: #fff; text-align: center; }
  .cta::before { content: ''; display: block; width: 2.2rem; height: 3.2rem; margin: 0 auto 0.9rem; background: url('../../assets/balao-traco.png') center / contain no-repeat; }
  .cta-t { margin: 0; font-family: var(--font-title); font-weight: 700; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem); line-height: 1.2; }
  .btn { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1.4rem; padding: 0.85rem 1.5rem; border-radius: 999px; background: var(--orange-light); color: var(--navy); font-weight: 500; text-decoration: none; }
  .btn:hover { background: #f8b47e; }

  .compartilhar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 1rem 0; border-top: 1px dashed rgba(1, 62, 80, 0.3); border-bottom: 1px dashed rgba(1, 62, 80, 0.3); font-size: 0.95rem; }
  .compartilhar span { font-weight: 500; }
  .compartilhar a, .compartilhar button { color: var(--navy); font: inherit; background: none; border: 0; padding: 0; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; cursor: pointer; }
  /* Janela do Instagram */
  .story { width: min(24rem, calc(100vw - 1.5rem)); max-height: calc(100dvh - 1.5rem); margin: auto; padding: 1.5rem 1.25rem 1rem; border: 0; border-radius: 1rem; background: var(--cream); color: var(--navy); text-align: center; }
  .story::backdrop { background: rgba(1, 62, 80, 0.75); }
  .fechar { position: absolute; top: 0.4rem; right: 0.6rem; border: 0; background: none; color: var(--navy); font-size: 1.8rem; line-height: 1; cursor: pointer; }
  .story-t { margin: 0 1.5rem 1rem; font-family: var(--font-title); font-weight: 800; font-size: 1.25rem; line-height: 1.2; }
  .story canvas { display: block; height: min(20rem, 42dvh); width: auto; margin: 0 auto; border-radius: 0.6rem; background: #1b5360; box-shadow: 0 8px 20px rgba(1, 62, 80, 0.3); }
  .story ol { margin: 1rem auto 0; max-width: 18rem; padding-left: 1.25rem; text-align: left; font-size: 0.9rem; line-height: 1.55; }
  .enviar { border: 0; font: inherit; font-weight: 500; cursor: pointer; margin-top: 0.9rem; }
  .enviar:disabled { opacity: 0.6; cursor: wait; }
  .aviso { min-height: 1.4em; margin: 0.5rem 0 0; font-size: 0.9rem; font-weight: 500; }
  .volta { display: inline-block; margin-top: 1.5rem; color: var(--navy); font-weight: 600; }
  a:focus-visible, button:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
  .cta .btn:focus-visible { outline-color: #fff; }

  @keyframes floaty { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-12px) rotate(2deg); } }
  @media (min-width: 900px) {
    .arch { right: 4rem; width: 16rem; height: 20rem; border-radius: 8rem 8rem 0 0; }
    .topo :global(.bal) { right: 7.5rem; bottom: 6rem; width: 10rem; }
    .inner { padding: 1rem 1.25rem 7rem; }
    h1 { padding-right: 0; max-width: 38rem; }
  }
</style>
