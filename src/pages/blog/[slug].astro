---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import { canonicalUrl } from '../../lib/seo';
import { optionalCollection } from '../../lib/optional-collection';
import { dataBR, dataISO } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await optionalCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { titulo, descricao, capa, capaAlt, data, autor } = entry.data;
const { Content } = await render(entry);
const path = `/blog/${entry.id}/`;
const crumbs = [{ name: 'Blog', path: '/blog/' }, { name: titulo, path }];
const imagemOg = await getImage({ src: capa, width: 1200 });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: dataISO(data),
  author: { '@type': 'Person', name: autor },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  image: new URL(imagemOg.src, SITE.url).href,
  mainEntityOfPage: canonicalUrl(path),
};
---
<BaseLayout title={titulo} description={descricao} path={path} breadcrumbs={crumbs}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="post">
    <header>
      <h1>{titulo}</h1>
      <p class="meta"><time datetime={dataISO(data)}>{dataBR(data)}</time> · <span>{autor}</span></p>
    </header>
    <Image src={capa} alt={capaAlt} widths={[480, 960, 1440]} sizes="(min-width: 900px) 48rem, 100vw" loading="eager" />
    <div class="corpo"><Content /></div>
    <a class="volta" href="/blog/"><span aria-hidden="true">←</span> Todos os posts</a>
  </article>
</BaseLayout>
<style>
  .post { max-width: 48rem; margin: 0 auto; padding: 2rem 1.25rem 3.5rem; color: var(--navy); }
  h1 { margin: 0; font-weight: 800; font-size: clamp(1.75rem, 1.2rem + 2.5vw, 2.75rem); line-height: 1.1; overflow-wrap: anywhere; }
  .meta { margin: 0.75rem 0 1.5rem; font-size: 0.875rem; letter-spacing: 0.06em; color: var(--teal); }
  .post :global(img) { width: 100%; height: auto; border-radius: 0.625rem; box-shadow: 0 6px 18px rgba(1, 62, 80, 0.15); }
  .corpo { margin-top: 1.75rem; font-size: 1.0625rem; }
  .corpo :global(p) { margin: 0 0 1.1rem; line-height: 1.7; }
  .corpo :global(h2) { margin: 2rem 0 0.6rem; font-weight: 800; }
  .volta { display: inline-block; margin-top: 2rem; color: var(--navy); font-weight: 600; }
  .volta:focus-visible { outline: 3px solid var(--orange); outline-offset: 3px; }
</style>
