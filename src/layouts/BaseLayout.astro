---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/seo';

interface Props {
  title?: string;
  description: string;
  path: string;
  breadcrumbs?: { name: string; path: string }[];
  theme?: 'dark' | 'light';
  noindex?: boolean;
}
const { title, description, path, breadcrumbs, theme = 'light', noindex } = Astro.props;
const hasCrumbs = !!breadcrumbs && breadcrumbs.length > 0;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} path={path} noindex={noindex} />
    {hasCrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: 'Home', path: '/' }, ...breadcrumbs!]))} />}
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <Header path={path} />
    {hasCrumbs && <Breadcrumbs items={breadcrumbs!} />}
    <main id="conteudo" tabindex="-1"><slot /></main>
    <Footer />
    <StickyCta />
  </body>
</html>
<style is:global>
  body[data-theme='dark'] { background: var(--navy); color: #fff; }
  main:focus { outline: none; }
</style>
