---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema } from '../lib/seo';
import jost from '@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';
import bitter400 from '@fontsource/bitter/files/bitter-latin-400-normal.woff2?url';
import bitter700 from '@fontsource/bitter/files/bitter-latin-700-normal.woff2?url';
import bitter800 from '@fontsource/bitter/files/bitter-latin-800-normal.woff2?url';
import bitter400i from '@fontsource/bitter/files/bitter-latin-400-italic.woff2?url';
import bitter700i from '@fontsource/bitter/files/bitter-latin-700-italic.woff2?url';

// As fontes do site (poucas, só latin) são pedidas junto com o HTML.
const fontes = [jost, bitter400, bitter700, bitter800, bitter400i, bitter700i];

interface Props {
  title?: string;
  description: string;
  path: string;
  breadcrumbs?: { name: string; path: string }[];
  theme?: 'dark' | 'light';
  noindex?: boolean;
  /** false quando a página desenha o caminho (ex.: PageHead); o JSON-LD continua sendo emitido. */
  showBreadcrumbs?: boolean;
}
const { title, description, path, breadcrumbs, theme = 'light', noindex, showBreadcrumbs = true } = Astro.props;
const hasCrumbs = !!breadcrumbs && breadcrumbs.length > 0;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {fontes.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <Seo title={title} description={description} path={path} noindex={noindex} />
    {hasCrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema([{ name: 'Home', path: '/' }, ...breadcrumbs!]))} />}
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    <Header path={path} />
    {hasCrumbs && showBreadcrumbs && <Breadcrumbs items={breadcrumbs!} />}
    <main id="conteudo" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
<style is:global>
  body[data-theme='dark'] { background: var(--navy); color: #fff; }
  main:focus { outline: none; }
</style>
