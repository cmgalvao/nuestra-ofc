---
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';
import balao from '../assets/balao.png';
import papel from '../assets/papel.png';

interface Props { title: string; intro?: string; crumbs: { name: string; path: string }[] }
const { title, intro, crumbs } = Astro.props;
---
<section class="page-head">
  <div class="grain" aria-hidden="true"></div>
  <div class="arch" aria-hidden="true"></div>
  <Image class="bal" src={balao} alt="" widths={[160, 320]} sizes="(min-width: 900px) 160px, 96px" loading="eager" />
  <div class="inner">
    <div class="trail"><Breadcrumbs items={crumbs} /></div>
    <h1 style={`--papel: url(${papel.src})`}><span>{title}</span></h1>
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>
<style>
  .page-head { position: relative; overflow: hidden; background: var(--teal); color: #fff; }
  .grain { position: absolute; inset: 0; background-image: var(--grain); opacity: var(--grain-opacity); mix-blend-mode: overlay; pointer-events: none; }
  .arch { position: absolute; right: -2rem; bottom: 0; width: 10rem; height: 13.75rem; background: #DF673D; border-radius: 5rem 5rem 0 0; }
  .bal { position: absolute; right: 0.6rem; bottom: 2.5rem; width: 6rem; height: auto; animation: floaty 7s ease-in-out infinite; }
  .inner { position: relative; max-width: 72rem; margin: 0 auto; padding: 0.5rem 1.25rem 2.5rem; }
  .trail :global(.breadcrumbs) { padding: 0.75rem 0; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.85); }
  .trail :global(ol) { margin: 0; }
  h1 { margin: 0.5rem 0 0 -0.5rem; font-size: clamp(1.75rem, 9vw, 3rem); font-weight: 800; color: var(--navy); line-height: 1.1; }
  h1 span {
    display: inline-block; padding: 0.3rem 0.9rem; transform: rotate(-2deg);
    background: var(--papel) center / cover #f4efe6; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    overflow-wrap: anywhere;
  }
  .intro { margin-top: 1.25rem; max-width: 34rem; padding-right: 6.5rem; font-size: 1rem; line-height: 1.5; color: #fff; }
  @keyframes floaty { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-12px) rotate(2deg); } }
  @media (min-width: 900px) {
    .arch { right: 4rem; width: 16rem; height: 20rem; border-radius: 8rem 8rem 0 0; }
    .bal { right: 7rem; bottom: 4rem; width: 10rem; }
    .inner { padding: 1rem 1.25rem 4rem; }
    .intro { padding-right: 18rem; font-size: 1.125rem; }
  }
</style>
