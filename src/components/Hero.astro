---
import { Picture } from 'astro:assets';
import { SITE } from '../config/site';
import { whatsappUrl } from '../lib/contact';
import balao from '../assets/balao.png';

const DESTAQUE = 'último clique';
const [antes, depois] = SITE.tagline.split(DESTAQUE);
---
<section id="decolagem" class="hero">
  <div class="grain" aria-hidden="true"></div>
  <div class="inner">
    <div class="copy">
      <h1>{antes}<em>{DESTAQUE}</em>{depois}</h1>
      <p class="sub">{SITE.taglineSub}</p>
      <div class="ctas">
        <a class="btn primary" href="#servicos">Conheça os serviços<span class="arr" aria-hidden="true"> ↓</span></a>
        <a class="btn ghost wa" href={whatsappUrl()} target="_blank" rel="noopener">Falar com a Nuestra</a>
      </div>
    </div>
    <div class="sky">
      <div class="rise" data-balao>
        <Picture
          class="bal"
          src={balao}
          alt=""
          widths={[320, 480, 640]}
          sizes="(min-width: 900px) 320px, 240px"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          loading="eager"
          fetchpriority="high"
        />
        <span class="traco" aria-hidden="true"></span>
      </div>
    </div>
  </div>
  <div class="clouds" aria-hidden="true"></div>
</section>
<script>
  import '../scripts/hero-motion';
</script>
<style>
  .hero {
    position: relative; overflow: hidden; color: #fff;
    background: var(--sky-gradient); min-height: 100vh; min-height: 100svh;
    display: flex; flex-direction: column;
  }
  .grain {
    position: absolute; inset: 0; z-index: 8; pointer-events: none;
    background-image: var(--grain); opacity: var(--grain-opacity); mix-blend-mode: overlay;
  }
  .inner {
    position: relative; flex: 1; width: 100%; max-width: 72rem; margin: 0 auto;
    padding: 5.75rem 1.25rem 0; display: flex; flex-direction: column;
  }
  .copy { position: relative; z-index: 5; }
  h1 {
    font-weight: 400; font-size: clamp(1.85rem, 0.9rem + 4.6vw, 3.5rem); line-height: 1.08;
    letter-spacing: -0.01em; max-width: 15ch; text-wrap: balance;
  }
  h1 em { font-style: italic; font-weight: 700; color: var(--orange-light); }
  .sub { margin-top: 1rem; max-width: 24rem; font-size: 1rem; line-height: 1.45; }
  .ctas { margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .btn {
    display: inline-block; padding: 0.7rem 1.15rem; border-radius: 999px; font-weight: 500; font-size: 0.9375rem;
    text-decoration: none; line-height: 1.3; transition: background-color 0.2s, color 0.2s;
  }
  .btn:focus-visible { outline: 3px solid var(--orange-light); outline-offset: 3px; }
  .primary { color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.75); }
  .primary:hover { background: rgba(255, 255, 255, 0.12); }
  .ghost { color: #fff; border: 1.5px solid rgba(255, 255, 255, 0.75); }
  .ghost:hover { background: rgba(255, 255, 255, 0.12); }
  /* No celular o CTA fixo (StickyCta) faz o papel deste botão, como no mockup. */
  .wa { display: none; }

  .sky { position: relative; z-index: 3; flex: 1; min-height: 15rem; display: flex; justify-content: flex-end; align-items: flex-end; padding: 1.5rem 0.75rem 6.25rem 0; }
  .rise { position: relative; width: min(56vw, 13.75rem); will-change: transform; }
  .rise :global(picture) { display: block; }
  .bal { width: 100%; height: auto; animation: floaty 7s ease-in-out infinite; filter: drop-shadow(0 18px 24px rgba(1, 30, 40, 0.25)); }
  .traco {
    position: absolute; inset: 0; opacity: 0; pointer-events: none;
    background: url('../assets/balao-traco.png') center / contain no-repeat;
  }
  /* Intro opcional (INTRO_TRACO em hero-motion.ts): o traço vira o balão. */
  .rise:global(.intro) .bal { opacity: 0; }
  .rise:global(.intro) .traco { opacity: 1; }
  .rise:global(.intro-go) .bal { opacity: 1; transition: opacity 1.2s ease 0.3s; }
  .rise:global(.intro-go) .traco { opacity: 0; transform: scale(1.06); transition: opacity 1s ease, transform 1.2s ease; }

  .clouds {
    /* Uma única faixa de nuvens na base do céu. nuvem-faixa.webp = nuvem.png + a mesma espelhada,
       por isso se repete na horizontal sem emendas. */
    position: absolute; left: -2rem; right: -2rem; bottom: -1rem; height: 9.5rem; z-index: 6; pointer-events: none;
    background: url('../assets/nuvem-faixa.webp') -10.5rem bottom / auto 100% repeat-x;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
  }

  @media (min-width: 600px) {
    .rise { width: 15rem; }
  }
  @media (min-width: 900px) {
    .inner { flex-direction: row; align-items: center; gap: 2rem; padding: 6.5rem 2.75rem 7rem; }
    .copy { flex: 1 1 36rem; }
    h1 { max-width: 17.5ch; }
    .sub { margin-top: 1.5rem; max-width: none; font-size: 1.1875rem; }
    .ctas { margin-top: 1.5rem; }
    .btn { padding: 0.85rem 1.4rem; font-size: 1rem; }
    .primary { background: var(--orange-light); color: var(--navy); border-color: var(--orange-light); }
    .primary:hover { background: #f8b47e; }
    .primary .arr { display: none; }
    .wa { display: inline-block; }
    .sky { flex: 0 1 22rem; min-height: 0; align-self: stretch; align-items: center; justify-content: center; padding: 0 3rem 0 0; }
    .rise { width: clamp(15rem, 24vw, 20rem); }
    .clouds { height: 10.5rem; bottom: -2.5rem; left: -3rem; right: -3rem; background-position: center bottom; }
  }
</style>
