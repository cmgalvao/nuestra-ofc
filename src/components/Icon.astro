---
interface Props {
  name: 'email' | 'instagram' | 'whatsapp' | 'pin' | 'arrow';
  label?: string;
}
const { name, label } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="20"
  height="20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 7 8.5-7" /></>)}
  {name === 'instagram' && (<><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17" cy="7" r="0.6" fill="currentColor" /></>)}
  {name === 'whatsapp' && (<><path d="M4 20l1.3-4.3A8 8 0 1 1 8.4 18.8L4 20Z" /><path d="M9.2 8.8c.2 2.6 3.2 5.6 5.9 6l1.2-1.3-2-1-.9.7c-.9-.4-1.9-1.4-2.3-2.3l.7-.9-1-2-1.6.8Z" /></>)}
  {name === 'pin' && (<><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>)}
  {name === 'arrow' && (<path d="M5 12h14m-6-6 6 6-6 6" />)}
</svg>
