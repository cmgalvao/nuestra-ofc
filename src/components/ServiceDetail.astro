---
import { render, type CollectionEntry } from 'astro:content';
import { whatsappUrl } from '../lib/contact';

interface Props { servico: CollectionEntry<'servicos'> }
const { servico } = Astro.props;
const { slug, nome, frase, entregas, order } = servico.data;
const n = String(order).padStart(2, '0');
const { Content } = await render(servico);
const hasBody = !!servico.body?.trim();
---
<article class="detail" id={slug} aria-labelledby={`${slug}-titulo`}>
  <div class="top" aria-hidden="true"><span>DESTINO {n}</span><span>{nome.toUpperCase()}</span></div>
  <div class="in">
    <h2 id={`${slug}-titulo`}>{nome}</h2>
    <p class="frase">{frase}</p>
    {hasBody && <div class="corpo"><Content /></div>}
    {entregas.length > 0 && (
      <>
        <h3 class="k">O que entregamos</h3>
        <ul>{entregas.map((e) => <li>{e}</li>)}</ul>
      </>
    )}
    <a class="btn" href={whatsappUrl()} target="_blank" rel="noopener">Falar com a Nuestra</a>
  </div>
</article>
<style>
  .detail { background: #fff; border-radius: 0.75rem; box-shadow: 0 6px 18px rgba(1, 62, 80, 0.12); overflow: hidden; scroll-margin-top: 1rem; }
  .top { display: flex; justify-content: space-between; gap: 0.75rem; background: var(--navy); color: #fff; padding: 0.55rem 1rem; font-size: 0.6875rem; letter-spacing: 0.2em; }
  .in { padding: 1.25rem 1rem 1.5rem; }
  h2 { font-weight: 800; font-size: clamp(1.4rem, 6vw, 1.9rem); line-height: 1.15; overflow-wrap: anywhere; }
  .frase { margin: 0.25rem 0 0.75rem; font-family: var(--font-title); font-style: italic; font-weight: 700; font-size: 1.2rem; line-height: 1.3; color: var(--orange); }
  .corpo :global(p) { margin: 0 0 1rem; line-height: 1.6; color: #1d4452; }
  .k { margin: 0 0 0.4rem; font-family: var(--font-body); font-weight: 400; font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(1, 62, 80, 0.75); }
  ul { margin: 0 0 1.25rem; padding: 0; list-style: none; }
  li { padding: 0.4rem 0; border-top: 1px dashed rgba(1, 62, 80, 0.25); }
  li::before { content: '✓ '; color: var(--orange); font-weight: 700; }
  .btn { display: inline-block; margin-top: 0.25rem; background: var(--orange-light); color: var(--navy); font-weight: 500; padding: 0.75rem 1.4rem; border-radius: 999px; text-decoration: none; }
  .btn:focus-visible { outline: 3px solid var(--navy); outline-offset: 3px; }
  @media (min-width: 900px) { .in { padding: 1.75rem 2rem 2rem; } .top { padding: 0.6rem 2rem; } }
</style>
