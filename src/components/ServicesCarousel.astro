---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BoardingPass from './BoardingPass.astro';
import balao from '../assets/balao.png';

const servicos = (await getCollection('servicos')).sort((a, b) => a.data.order - b.data.order);
---
<section id="servicos" class="servicos" aria-labelledby="servicos-titulo">
  <div class="grain" aria-hidden="true"></div>
  <div class="arch" aria-hidden="true"></div>
  <Image class="bal" src={balao} alt="" widths={[160, 320]} sizes="(min-width: 900px) 160px, 112px" />
  <div class="inner">
    <h2 id="servicos-titulo">Escolha seu voo <span>ou voe com a gente em todos.</span></h2>
  </div>
  <ul class="row" role="list" aria-label="Serviços" data-carousel>
    {servicos.map((s) => (
      <li>
        <BoardingPass
          numero={s.data.order}
          nome={s.data.nome}
          frase={s.data.frase}
          href={`/servicos/#${s.data.slug}`}
          destaque={s.data.slug === 'marketing-360'}
        />
      </li>
    ))}
  </ul>
  <div class="inner foot">
    <div class="dots" aria-hidden="true">
      {servicos.map((_, i) => <i data-dot data-active={i === 0 ? '' : undefined}></i>)}
    </div>
    <p class="hint">Arraste para ver os {servicos.length} serviços</p>
  </div>
</section>
<style>
  .servicos { position: relative; overflow: hidden; background: var(--teal); color: #fff; padding: 4.5rem 0 3rem; }
  .grain { position: absolute; inset: 0; z-index: 1; pointer-events: none; background-image: var(--grain); opacity: var(--grain-opacity); mix-blend-mode: overlay; }
  .arch {
    position: absolute; right: -4.5rem; top: 3rem; width: 12.5rem; height: 21rem;
    background: var(--orange); border-radius: 6.25rem 6.25rem 0 0;
  }
  .bal { position: absolute; right: 0.5rem; top: 1.25rem; width: 6.5rem; height: auto; z-index: 2; animation: floaty 7s ease-in-out infinite; }
  .inner { position: relative; z-index: 3; max-width: 72rem; margin: 0 auto; padding: 0 1.25rem; }
  /* O título fica sobre o verde, sem invadir o arco laranja. */
  h2 { font-weight: 400; font-size: clamp(1.6rem, 1.1rem + 2.6vw, 2.75rem); line-height: 1.12; max-width: calc(100% - 7rem); }
  h2 span { display: block; font-weight: 800; color: var(--orange-light); }
  .row {
    --gutter: 1.25rem;
    position: relative; z-index: 3; list-style: none; margin: 2rem 0 0; padding: 0.75rem var(--gutter) 1.25rem;
    display: flex; gap: 0.875rem; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
    scrollbar-width: thin; scrollbar-color: rgba(245, 161, 96, 0.7) transparent;
  }
  .row li { flex: 0 0 15rem; scroll-snap-align: start; display: flex; }
  .row :global(.pass.destaque) { transform: rotate(-2deg) translateY(-4px); }
  .foot { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.5rem; }
  .row:global([data-fits]) + .foot { display: none; }
  .dots { display: flex; gap: 0.4rem; }
  .dots i { width: 0.45rem; height: 0.45rem; border-radius: 999px; background: rgba(255, 255, 255, 0.4); transition: width 0.25s, background-color 0.25s; }
  .dots i[data-active] { width: 1.25rem; background: var(--orange-light); }
  .hint { font-size: 0.8125rem; opacity: 0.85; }
  @keyframes floaty {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
  }
  @media (min-width: 600px) {
    .arch { right: -3rem; width: 16rem; height: 24rem; border-radius: 8rem 8rem 0 0; }
    .bal { right: 2rem; width: 8rem; }
    h2 { max-width: calc(100% - 14rem); }
  }
  @media (min-width: 900px) {
    .servicos { padding: 6rem 0 4rem; }
    .arch { right: 5%; top: 3rem; width: 21rem; height: 29rem; border-radius: 10.5rem 10.5rem 0 0; }
    .bal { right: calc(5% + 5rem); top: 1.25rem; width: 10rem; }
    .inner { padding: 0 2.75rem; }
    h2 { max-width: calc(100% - 24rem); }
    /* Faixa de cartões de ponta a ponta, alinhada à esquerda com o título. */
    .row { --gutter: max(2.75rem, calc((100% - 72rem) / 2 + 2.75rem)); margin-top: 2.75rem; padding-top: 1rem; padding-bottom: 1.5rem; gap: 1rem; }
  }
</style>
