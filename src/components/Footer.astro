---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import { SITE, NAV } from '../config/site';
import { mailtoUrl, whatsappUrl } from '../lib/contact';
import logo from '../assets/logo-horizontal.png';
import Icon from './Icon.astro';
---
<footer class="site-footer">
  <div class="inner">
    <a class="logo" href={withBase('/')}>
      <Image src={logo} alt="Nuestra Agência" height={36} widths={[120, 240]} sizes="120px" />
    </a>
    <nav aria-label="Rodapé">
      <ul class="links">
        {NAV.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <ul class="contacts">
      <li><a href={mailtoUrl()}><Icon name="email" /> {SITE.email}</a></li>
      <li><a href={SITE.instagramUrl} target="_blank" rel="noopener"><Icon name="instagram" /> {SITE.instagramHandle}</a></li>
      <li><a href={whatsappUrl()} target="_blank" rel="noopener"><Icon name="whatsapp" /> {SITE.whatsappDisplay}</a></li>
      <li class="place"><Icon name="pin" /> {SITE.cityDisplay}</li>
    </ul>
    <p class="copy">© {new Date().getFullYear()} {SITE.name}</p>
  </div>
</footer>
<style>
  .site-footer { background: var(--navy); color: #fff; padding: 3rem 1.25rem 2rem; }
  .inner { max-width: 72rem; margin: 0 auto; display: grid; gap: 1.75rem; }
  .logo { display: block; line-height: 0; width: fit-content; }
  .logo :global(img) { height: 2.25rem; width: auto; }
  ul { list-style: none; margin: 0; padding: 0; }
  .links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  a { color: #fff; text-decoration: none; }
  a:hover { text-decoration: underline; text-decoration-color: var(--orange-light); }
  a:focus-visible { outline: 3px solid var(--orange-light); outline-offset: 3px; }
  .contacts { display: grid; gap: 0.6rem; }
  .contacts li { display: flex; align-items: center; gap: 0.5rem; overflow-wrap: anywhere; }
  .contacts a { display: inline-flex; align-items: center; gap: 0.5rem; }
  .contacts :global(svg) { flex: none; color: var(--orange-light); }
  .copy { font-size: 0.875rem; opacity: 0.8; border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 1.25rem; }
  @media (min-width: 900px) {
    .inner { grid-template-columns: 1fr 1fr; align-items: start; }
    .copy { grid-column: 1 / -1; }
  }
</style>
