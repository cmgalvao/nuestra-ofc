---
import { whatsappUrl } from '../lib/contact';
---
<div class="sticky-cta">
  <a href={whatsappUrl()} target="_blank" rel="noopener">Falar com a Nuestra</a>
</div>
<style>
  .sticky-cta {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
    padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, transparent, rgba(1, 62, 80, 0.55));
  }
  .sticky-cta a {
    display: block; text-align: center; padding: 0.85rem 1rem; border-radius: 999px;
    background: var(--orange-light); color: var(--navy); font-weight: 500; text-decoration: none;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.25);
  }
  @media (min-width: 900px) { .sticky-cta { display: none; } }
</style>
<style is:global>
  @media (max-width: 899.98px) { body { padding-bottom: 5.5rem; } }
</style>
