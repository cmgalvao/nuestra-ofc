---
import { SITE } from '../config/site';
import { mailtoUrl, whatsappUrl } from '../lib/contact';
import Icon from './Icon.astro';

const links = [
  { icon: 'email', rotulo: 'E-mail', texto: SITE.email, href: mailtoUrl(), externo: false },
  { icon: 'instagram', rotulo: 'Instagram', texto: SITE.instagramHandle, href: SITE.instagramUrl, externo: true },
  { icon: 'whatsapp', rotulo: 'WhatsApp', texto: SITE.whatsappDisplay, href: whatsappUrl(), externo: true },
] as const;
---
<ul class="lista" role="list">
  {links.map((l) => (
    <li>
      <a class="linha" href={l.href} aria-label={`${l.rotulo}: ${l.texto}${l.externo ? ' (abre em nova aba)' : ''}`} target={l.externo ? '_blank' : undefined} rel={l.externo ? 'noopener' : undefined}>
        <span class="ic"><Icon name={l.icon} /></span>
        <span class="txt">
          <small>{l.rotulo}</small>
          <span class="valor">{l.texto}</span>
        </span>
      </a>
    </li>
  ))}
  <li class="linha local">
    <span class="pin"><Icon name="pin" /></span>
    <span class="txt">{SITE.cityDisplay}</span>
  </li>
</ul>
<style>
  .lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .linha {
    display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 0.75rem; border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.12); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    color: #fff; text-decoration: none; font-size: 0.9375rem; transition: background-color 0.2s;
  }
  a.linha:hover { background: rgba(255, 255, 255, 0.2); }
  a.linha:focus-visible { outline: 3px solid var(--orange-light); outline-offset: 3px; }
  .ic {
    flex: 0 0 2.125rem; width: 2.125rem; height: 2.125rem; border-radius: 50%;
    background: var(--orange-light); color: var(--navy); display: flex; align-items: center; justify-content: center;
  }
  .txt { min-width: 0; overflow-wrap: anywhere; }
  small { display: block; font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.8; }
  .local { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; padding: 0.4rem 0.75rem; gap: 0.75rem; }
  .pin { flex: 0 0 2.125rem; display: flex; justify-content: center; color: var(--orange-light); }
  @media (min-width: 900px) {
    .linha { font-size: 1.0625rem; padding: 0.85rem 1rem; }
  }
</style>
